<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#081822" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DRIVECORE  /  C10 REEV" android:textColor="#5DE7EB" android:textStyle="bold" android:textSize="24sp"/>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Esperando USB" android:textColor="#A9C2CE" android:textSize="14sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:layout_marginTop="12dp" android:layout_marginBottom="12dp">
        <ScrollView android:layout_width="0dp" android:layout_weight="4" android:layout_height="match_parent" android:background="#102D3B" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="INSTRUMENTACIÓN  /  AAOS" android:textStyle="bold" android:textColor="#5DE7EB" android:textSize="16sp"/>
                <ImageView android:layout_width="match_parent" android:layout_height="76dp" android:src="@drawable/car_silhouette" android:contentDescription="Silueta ilustrativa del vehículo" android:scaleType="fitCenter"/>
                <TextView android:id="@+id/speed" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="—" android:textSize="48sp" android:textColor="#FFFFFF" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BATERÍA" android:textColor="#A9C2CE" android:textSize="14sp"/>
                <TextView android:id="@+id/battery" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#5DE7EB" android:textSize="26sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="POTENCIA SALIENTE" android:textColor="#A9C2CE"/>
                <TextView android:id="@+id/outgoing" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#FFCA72" android:textSize="24sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="POTENCIA ENTRANTE · NO SOLO FRENO" android:textColor="#A9C2CE"/>
                <TextView android:id="@+id/incoming" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#5DE7EB" android:textSize="24sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="COMBUSTIBLE" android:textColor="#A9C2CE"/>
                <TextView android:id="@+id/fuel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#FFCA72" android:textSize="24sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AUTONOMÍA COMBINADA" android:textColor="#A9C2CE"/>
                <TextView android:id="@+id/range" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="24sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ODÓMETRO" android:textColor="#A9C2CE"/>
                <TextView android:id="@+id/odo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="20sp"/>
            </LinearLayout>
        </ScrollView>
        <LinearLayout android:layout_width="0dp" android:layout_weight="6" android:layout_height="match_parent" android:layout_marginStart="12dp" android:orientation="vertical" android:background="#102D3B" android:padding="16dp">
            <TextView android:id="@+id/mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Telemetría" android:textColor="#5DE7EB" android:textSize="22sp" android:textStyle="bold"/>
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp" android:background="#081822">
                <SurfaceView android:id="@+id/videoSurface" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"/>
                <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
                    <TextView android:id="@+id/detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:textColor="#D2E2EA" android:textSize="16sp" android:text="Esperando datos autorizados"/>
                </ScrollView>
            </FrameLayout>
            <Button android:id="@+id/permissions" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Permisos del vehículo"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/projection" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:text="Proyección USB" android:textSize="16sp"/>
        <Button android:id="@+id/tv" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:text="TDT" android:textSize="16sp"/>
        <Button android:id="@+id/telemetry" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:text="Telemetría" android:textSize="16sp"/>
    </LinearLayout>
</LinearLayout>
